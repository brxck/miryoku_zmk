/ {
    macros {
        tl_macro: tl_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LS(GRAVE))>, <&kp LG(LC(LA(LS(W))))>;
        };
    };

    behaviors {
        td_hy: td_hy {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LG(LS(LA(LC(Y))))>, <&kp LG(LS(LA(LC(X))))>;
        };
        td_cv: td_cv {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LG(C)>, <&kp LG(V)>;
        };
    };
};

#include "../miryoku/custom_config.h"
#include "../miryoku/mapping/42/corne.h"
#include "../miryoku/miryoku.dtsi"
