#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        tl_macro: tl_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LA(LS(GRAVE)) &kp LG(LC(LA(LS(W))))>
                , <&macro_pause_for_release>
                , <&macro_release &kp LA(LS(GRAVE)) &kp LG(LC(LA(LS(W))))>
                ;
        };
    };

    behaviors {
        td_hy: td_hy {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LG(LS(LA(LC(Y))))>, <&kp LG(LS(LA(LC(X))))>;
        };
        td_cv: td_cv {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LG(C)>, <&kp LG(V)>;
        };
    };
};

#include "../miryoku/custom_config.h"
#include "../miryoku/mapping/42/corne.h"
#include "../miryoku/miryoku.dtsi"
